[project]
entrypoint = "server.js"
requires = [ "nodejs-24" ]
project_type = "app"
project_id = "7691163093270822962"
app_id = "7691196097645035547"
project_name = "AI Fitness Coach"
template = "expo"
version = "0.1.9"
appliedPatches = [ ]

[dev]
build = [ "bash", ".cozeproj/scripts/dev_build.sh" ]
build_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  ".cozeproj/scripts/dev_build.ps1"
]
run = [ "bash", ".cozeproj/scripts/dev_run.sh" ]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  ".cozeproj/scripts/dev_run.ps1"
]
validate = [ "bash", ".cozeproj/scripts/validate.sh" ]
validate_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  ".cozeproj/scripts/validate.ps1"
]

[deploy]
build = [ "bash", ".cozeproj/scripts/prod_build.sh" ]
run = [ "bash", ".cozeproj/scripts/prod_run.sh" ]
build_app_dir = "./client"
